# Copy to `.env` and adjust. Every value is optional; defaults work as-is.

SJ_MODEL_ID=stabilityai/stable-diffusion-2-1
SJ_DEVICE=auto              # auto | cuda | mps | cpu
SJ_NUM_INFERENCE_STEPS=25
SJ_GUIDANCE_SCALE=8.5
SJ_IMAGE_SIZE=512

# Only needed for gated models on the Hugging Face Hub.
# SJ_HF_TOKEN=hf_xxx

# Origins allowed to call the API when running the frontend dev server
# separately. Ignored in production (frontend is served from the same origin).
# SJ_ALLOWED_ORIGINS=["http://localhost:5173"]
